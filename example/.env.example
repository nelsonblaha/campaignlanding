# Copy to .env and fill in. Never commit the real file.
#
# CAMPAIGN_SECRET_KEY signs the admin session cookie. Keep it stable, or every
# signed-in device is signed out on the next deploy:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CAMPAIGN_SECRET_KEY=

# The password hash does NOT go here, and this is the single most annoying thing
# to discover by debugging: a Werkzeug hash uses '$' as its field separator, and
# Compose interpolates $VAR inside a project .env file. That removes the salt
# from the middle of the hash and leaves a value that is well-formed, non-empty,
# and wrong, so every correct password is rejected with no clue why.
#
# Put it in a file in the data volume instead:
#
#   printf %s 'the-password' | docker exec -i campaign-example python -c \
#     "import sys; from werkzeug.security import generate_password_hash as g; print(g(sys.stdin.read()))" \
#     > data/admin_password_hash
#   chmod 600 data/admin_password_hash
#
# Override the location with CAMPAIGN_ADMIN_HASH_FILE. CAMPAIGN_ADMIN_PASSWORD_HASH
# still works for deployments that are not Compose, but it must not contain an
# unescaped '$'.
#
# Leave both unset and there is no administrator: /login and /admin 404, and the
# page carries no admin markup at all.

# Set to 1 once the canonical hostname is verified serving the site end to end.
# Early, this 301s every visitor to a name that does not resolve yet, and a 301
# is the response browsers cache hardest.
# CAMPAIGN_CANONICAL_REDIRECT=1
